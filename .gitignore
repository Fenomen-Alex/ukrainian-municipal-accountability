# v3 control data is a byte-identical copy of the already-tracked
# ml/data/tune/v2/*.jsonl. Committing it would add 26M of zero information to the
# repository. build_control.py regenerates it deterministically and
# ml/data/tune/v3/control/meta.json records the sha256 that the test suite
# compares against ml/tune/build_control.py's output.
ml/data/tune/v3/control/*.jsonl

# v3.2 generated corpora, for the same reason: build_v3_2.py regenerates them
# deterministically. What is tracked instead is everything needed to audit the
# corpus without rebuilding it -- meta.json (composition, integrity, sha256),
# exposure.json (target-token share per stream) and provenance.jsonl (which
# train-split record produced each new row).
ml/data/tune/v3/treatment_v3_2/train.jsonl
ml/data/tune/v3/treatment_v3_2/validation.jsonl
ml/data/tune/v3/treatment_v3_2/test.jsonl

# per-step logs from run_v3_experiment.sh; regenerated on every run
ml/data/tune/v3/logs/

# Source-derived / generated corpora removed from the public tree (path B).
# They are reproducible from the official CC BY source via the deterministic
# pipeline; see REPRODUCIBILITY.md. Keep them untracked.
ml/data/train.jsonl
ml/data/validation.jsonl
ml/data/test.jsonl
ml/data/tune/multitopic/train.jsonl
ml/data/tune/multitopic/eval.jsonl
ml/data/tune/v2/train.jsonl
ml/data/tune/v2/validation.jsonl
ml/data/tune/v2/valid.jsonl
ml/data/tune/v2/test.jsonl
ml/data/tune/v3/treatment/train.jsonl
ml/data/tune/v3/treatment/validation.jsonl
ml/data/tune/v3/treatment/test.jsonl
