FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y curl ca-certificates wget python3 python3-pip tar && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN wget -q https://github.com/ggml-org/llama.cpp/releases/download/b11476/llama-b11476-bin-ubuntu-cuda-12.8-x64.tar.gz -O /tmp/llama.tar.gz && \
    tar -xzf /tmp/llama.tar.gz -C /tmp && \
    cp /tmp/llama-b11476/llama-server /app/llama-server && \
    cp /tmp/llama-b11476/*.so* /app/ 2>/dev/null || true && \
    chmod +x /app/llama-server && \
    rm -rf /tmp/llama.tar.gz /tmp/llama-b11476
ENV LD_LIBRARY_PATH=/app:$LD_LIBRARY_PATH
RUN pip3 install --no-cache-dir --break-system-packages huggingface_hub
ENV MODEL_FILE=Qwen3-8B-v2-q4_k_m.gguf
ENV HF_REPO=Fenomen-Alex/ukrainian-municipal-accountability-qwen3-8b-gguf
ENV PORT=8080
ENV HOST=0.0.0.0
RUN python3 -c "from huggingface_hub import hf_hub_download; import os; p=hf_hub_download(repo_id=os.environ['HF_REPO'], filename=os.environ['MODEL_FILE']); open('/app/model.path','w').write(p)"
RUN ln -s "$(cat /app/model.path)" /app/model.gguf
EXPOSE 8080
CMD ["/app/llama-server", "--model", "/app/model.gguf", "--host", "0.0.0.0", "--port", "8080", "--threads", "4", "--parallel", "1", "--n-gpu-layers", "99"]
